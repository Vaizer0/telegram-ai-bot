# Copy this file to .env and adjust values, then run the bot:
#   cp .env.example .env        (Termux / Linux / macOS)
#   copy .env.example .env      (Windows)
#
# IMPORTANT: keep .env private and never commit it to a repository.

# ---- Telegram ----
# Token from @BotFather (https://t.me/BotFather).
# Paste YOUR real token here. Never commit the real token.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ---- AI provider (OpenAI-compatible) ----
# Must be the OpenAI-compatible API root. The provider root
# https://opencode.ai/zen needs the /v1 prefix because the real endpoint is
# https://opencode.ai/zen/v1/chat/completions
AI_BASE_URL=https://opencode.ai/zen/v1
AI_API_KEY=public
AI_MODEL=big-pickle

# Optional: override the AI personality.
AI_SYSTEM_PROMPT=You are a helpful, polite assistant. Keep your answers concise and clear.

# ---- Run mode ----
# "polling" is the easiest setup (no public URL needed) and is the default.
BOT_MODE=polling

# ---- Webhook (only needed when BOT_MODE=webhook) ----
# Public HTTPS URL where the bot server is reachable, e.g. https://bot.example.com
WEBHOOK_URL=
# Random string that guards the webhook endpoint.
WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBHOOK_PORT=8443
